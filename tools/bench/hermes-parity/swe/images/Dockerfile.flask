FROM hermes-agent-nonroot:latest
USER root
ENV UV_PYTHON_INSTALL_DIR=/usr/local/uv-python
RUN uv venv --python 3.9 /usr/local/venv && uv pip install --python /usr/local/venv/bin/python click==8.0.1 itsdangerous==2.1.2 Jinja2==3.0.1 MarkupSafe==2.1.3 Werkzeug==2.3.7 pytest==6.2.5 python-dotenv==0.19.0 blinker==1.4 typing-extensions asgiref==3.4.1 greenlet cryptography
COPY testbed /usr/local/testbed
RUN chmod -R a+rX /usr/local/uv-python /usr/local/venv /usr/local/testbed && /usr/local/venv/bin/python -m pip --version >/dev/null 2>&1; uv pip install --python /usr/local/venv/bin/python -e /usr/local/testbed --no-deps && chmod -R a+rX /usr/local/testbed && git config --system --add safe.directory '*'
RUN /usr/local/venv/bin/python -m compileall -q /usr/local/venv /usr/local/testbed >/dev/null 2>&1; chmod -R a+rX /usr/local/uv-python /usr/local/venv
USER 10001:10001
ENV PATH=/usr/local/venv/bin:/usr/local/hermes/bin:/usr/local/hermes/.venv/bin:/usr/local/bin:/usr/bin:/bin
