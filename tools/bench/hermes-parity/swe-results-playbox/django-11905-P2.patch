+import os
+os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'tests.settings')
+
+import django
+django.setup()
+
+from tests.lookup.models import Season
+
+# Create a test season
+season = Season.objects.create(year=2020, nulled_text_field="test")
+
+# Test with boolean value
+print("Test with True:", Season.objects.filter(nulled_text_field__isnull=True).exists())
+print("Test with False:", Season.objects.filter(nulled_text_field__isnull=False).exists())
+
+# Test with non-boolean values
+print("Test with 1:", Season.objects.filter(nulled_text_field__isnull=1).exists())
+print("Test with 0:", Season.objects.filter(nulled_text_field__isnull=0).exists())
+print("Test with 'yes':", Season.objects.filter(nulled_text_field__isnull='yes').exists())
+print("Test with '':", Season.objects.filter(nulled_text_field__isnull='').exists())
+
