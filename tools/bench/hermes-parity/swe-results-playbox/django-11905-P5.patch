+import os
+import django
+os.environ['DJANGO_SETTINGS_MODULE'] = 'tests.test_sqlite'
+django.setup()
+
+from tests.lookup.models import Season
+
+# Try using isnull with an integer
+try:
+    q = Season.objects.filter(nulled_text_field__isnull=1)
+    print('isnull=1 works (should fail)')
+    print(f'Query: {q.query}')
+except Exception as e:
+    print(f'isnull=1 raises: {type(e).__name__}: {e}')
+
+try:
+    q = Season.objects.filter(nulled_text_field__isnull='True')
+    print('isnull="True" works (should fail)')
+    print(f'Query: {q.query}')
+except Exception as e:
+    print(f'isnull="True" raises: {type(e).__name__}: {e}')
+
+try:
+    q = Season.objects.filter(nulled_text_field__isnull=True)
+    print('isnull=True works (should work)')
+    # Try to execute it
+    list(q)
+    print('Successfully executed')
+except Exception as e:
+    print(f'isnull=True raises: {type(e).__name__}: {e}')
