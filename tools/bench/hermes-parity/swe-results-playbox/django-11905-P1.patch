@@ -0,0 +1,53 @@
+import os
+import sys
+import django
+os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'tests.settings')
+sys.path.insert(0, '/sandbox')
+
+# Configure Django
+django.setup()
+
+from tests.lookup.models import Article
+
+# Test with different values
+print("Testing __isnull with different values:")
+
+# Test with True
+print("Test 1: __isnull=True")
+try:
+    result = Article.objects.filter(headline__isnull=True)
+    print(f"  Success: {result.query}")
+except Exception as e:
+    print(f"  Error: {e}")
+
+# Test with False
+print("Test 2: __isnull=False")
+try:
+    result = Article.objects.filter(headline__isnull=False)
+    print(f"  Success: {result.query}")
+except Exception as e:
+    print(f"  Error: {e}")
+
+# Test with 1
+print("Test 3: __isnull=1")
+try:
+    result = Article.objects.filter(headline__isnull=1)
+    print(f"  Success: {result.query}")
+except Exception as e:
+    print(f"  Error: {e}")
+
+# Test with 0
+print("Test 4: __isnull=0")
+try:
+    result = Article.objects.filter(headline__isnull=0)
+    print(f"  Success: {result.query}")
+except Exception as e:
+    print(f"  Error: {e}")
+
+# Test with "True"
+print("Test 5: __isnull='True'")
+try:
+    result = Article.objects.filter(headline__isnull="True")
+    print(f"  Success: {result.query}")
+except Exception as e:
+    print(f"  Error: {e}")
