+import os
+import django
+os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'tests.test_sqlite')
+django.setup()
+
+from tests.lookup.models import Season
+
+# Try creating a season and filtering with non-boolean values
+season = Season.objects.create(year=2012)
+
+# Test with integer
+try:
+    result = Season.objects.filter(year__isnull=1)
+    print(f"Filter with isnull=1 succeeded: {list(result)}")
+except Exception as e:
+    print(f"Filter with isnull=1 failed: {e}")
+
+# Test with string
+try:
+    result = Season.objects.filter(year__isnull='true')
+    print(f"Filter with isnull='true' succeeded: {list(result)}")
+except Exception as e:
+    print(f"Filter with isnull='true' failed: {e}")
+
+# Test with None
+try:
+    result = Season.objects.filter(year__isnull=None)
+    print(f"Filter with isnull=None succeeded: {list(result)}")
+except Exception as e:
+    print(f"Filter with isnull=None failed: {e}")
+
+# Test with boolean (expected to work)
+try:
+    result = Season.objects.filter(year__isnull=True)
+    print(f"Filter with isnull=True succeeded: {list(result)}")
+except Exception as e:
+    print(f"Filter with isnull=True failed: {e}")
+
+try:
+    result = Season.objects.filter(year__isnull=False)
+    print(f"Filter with isnull=False succeeded: {list(result)}")
+except Exception as e:
+    print(f"Filter with isnull=False failed: {e}")
