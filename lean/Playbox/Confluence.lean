/-!
# Interaction-Net Port Confluence & Foliation Invariance

Models why local port-owned rewrites (Lafont interaction nets, Frostbite block contracts, and
single-owner Playbox worktree slices) merge without locks or conflicts:

1. Each rewrite `r` declares its read contract `reads` and exclusively owned write ports `writes`,
   satisfying `frame` (ports outside `writes` are untouched) and `locality` (new values on `writes`
   depend only on `reads`).
2. Two rewrites are `Orthogonal` when their write ports are disjoint and neither writes a port the
   other reads (`DisjointPorts`).
3. `apply_comm` proves the strong diamond property (`r₁ (r₂ s) = r₂ (r₁ s)`).
4. `foliation_invariance` proves that any permutation of pairwise-orthogonal rewrites (`FoliationEquiv`,
   generated by adjacent schedule swaps) settles to the exact same state (`applyAll rs₁ s = applyAll rs₂ s`).
5. `observer_invariant` proves that a bounded observer reading `obsPorts` is invariant to any
   rewrite whose `writes` is disjoint from `obsPorts`.
-/

namespace Playbox

/-- Disjoint port lists: no port belongs to both `xs` and `ys`. -/
def DisjointPorts (xs ys : List Nat) : Prop :=
  ∀ p, p ∈ xs → p ∉ ys

theorem disjointPorts_symm {xs ys : List Nat} (h : DisjointPorts xs ys) : DisjointPorts ys xs := by
  intro p hp hpx
  exact h p hpx hp

/-- A local contract-bounded state transition over port-indexed values `Nat → α`. -/
structure Rewrite (α : Type u) where
  reads    : List Nat
  writes   : List Nat
  step     : (Nat → α) → (Nat → α)
  frame    : ∀ (s : Nat → α) (p : Nat), p ∉ writes → step s p = s p
  locality : ∀ (s₁ s₂ : Nat → α),
    (∀ q, q ∈ reads → s₁ q = s₂ q) → ∀ p, p ∈ writes → step s₁ p = step s₂ p

/-- Interaction-net orthogonality: disjoint linear owners and preserved read contracts. -/
def Orthogonal {α : Type u} (r₁ r₂ : Rewrite α) : Prop :=
  DisjointPorts r₁.writes r₂.writes ∧
  DisjointPorts r₁.writes r₂.reads ∧
  DisjointPorts r₂.writes r₁.reads

theorem orthogonal_symm {α : Type u} {r₁ r₂ : Rewrite α} (h : Orthogonal r₁ r₂) :
    Orthogonal r₂ r₁ :=
  ⟨disjointPorts_symm h.1, h.2.2, h.2.1⟩

/-- Strong diamond property: two orthogonal local rewrites commute on every state. -/
theorem apply_comm {α : Type u} {r₁ r₂ : Rewrite α} (h : Orthogonal r₁ r₂) (s : Nat → α) :
    r₁.step (r₂.step s) = r₂.step (r₁.step s) := by
  obtain ⟨hww, hwr₁₂, hwr₂₁⟩ := h
  funext p
  by_cases hp₁ : p ∈ r₁.writes
  · have hp₂ : p ∉ r₂.writes := hww p hp₁
    have hrhs : r₂.step (r₁.step s) p = r₁.step s p := r₂.frame (r₁.step s) p hp₂
    have hlhs : r₁.step (r₂.step s) p = r₁.step s p := by
      apply r₁.locality (r₂.step s) s _ p hp₁
      intro q hq
      exact r₂.frame s q (fun hqw => hwr₂₁ q hqw hq)
    rw [hlhs, hrhs]
  · by_cases hp₂ : p ∈ r₂.writes
    · have hlhs : r₁.step (r₂.step s) p = r₂.step s p := r₁.frame (r₂.step s) p hp₁
      have hrhs : r₂.step (r₁.step s) p = r₂.step s p := by
        apply r₂.locality (r₁.step s) s _ p hp₂
        intro q hq
        exact r₁.frame s q (fun hqw => hwr₁₂ q hqw hq)
      rw [hlhs, hrhs]
    · rw [r₁.frame (r₂.step s) p hp₁, r₂.frame s p hp₂,
          r₂.frame (r₁.step s) p hp₂, r₁.frame s p hp₁]

/-- Apply a sequential schedule (foliation) of rewrites from head to tail. -/
def applyAll {α : Type u} : List (Rewrite α) → (Nat → α) → (Nat → α)
  | [], s => s
  | r :: rs, s => applyAll rs (r.step s)

/-- Every pair of distinct rewrites in the schedule is orthogonal. -/
inductive PairwiseOrthogonal {α : Type u} : List (Rewrite α) → Prop where
  | nil  : PairwiseOrthogonal []
  | cons : ∀ {r : Rewrite α} {rs : List (Rewrite α)},
      (∀ r', r' ∈ rs → Orthogonal r r') →
      PairwiseOrthogonal rs →
      PairwiseOrthogonal (r :: rs)

/-- Schedule equivalence under arbitrary permutations (generated by adjacent swaps). -/
inductive FoliationEquiv {α : Type u} : List (Rewrite α) → List (Rewrite α) → Prop where
  | refl  (rs : List (Rewrite α)) : FoliationEquiv rs rs
  | swap  (r₁ r₂ : Rewrite α) (rs : List (Rewrite α)) :
      FoliationEquiv (r₁ :: r₂ :: rs) (r₂ :: r₁ :: rs)
  | cons  (r : Rewrite α) {rs₁ rs₂ : List (Rewrite α)} :
      FoliationEquiv rs₁ rs₂ → FoliationEquiv (r :: rs₁) (r :: rs₂)
  | trans {rs₁ rs₂ rs₃ : List (Rewrite α)} :
      FoliationEquiv rs₁ rs₂ → FoliationEquiv rs₂ rs₃ → FoliationEquiv rs₁ rs₃

theorem foliationEquiv_mem {α : Type u} {rs₁ rs₂ : List (Rewrite α)}
    (h : FoliationEquiv rs₁ rs₂) : ∀ x, x ∈ rs₁ ↔ x ∈ rs₂ := by
  induction h with
  | refl _ => intro _; exact Iff.rfl
  | swap r₁ r₂ rs =>
    intro x
    constructor <;> intro hx
    · cases hx with
      | head => exact List.Mem.tail _ (List.Mem.head _)
      | tail _ hx' =>
        cases hx' with
        | head => exact List.Mem.head _
        | tail _ hrest => exact List.Mem.tail _ (List.Mem.tail _ hrest)
    · cases hx with
      | head => exact List.Mem.tail _ (List.Mem.head _)
      | tail _ hx' =>
        cases hx' with
        | head => exact List.Mem.head _
        | tail _ hrest => exact List.Mem.tail _ (List.Mem.tail _ hrest)
  | cons r _ ih =>
    intro x
    constructor <;> intro hx
    · cases hx with
      | head => exact List.Mem.head _
      | tail _ hrest => exact List.Mem.tail _ ((ih x).mp hrest)
    · cases hx with
      | head => exact List.Mem.head _
      | tail _ hrest => exact List.Mem.tail _ ((ih x).mpr hrest)
  | trans _ _ ih₁ ih₂ =>
    intro x
    exact Iff.trans (ih₁ x) (ih₂ x)

theorem foliationEquiv_pairwise {α : Type u} {rs₁ rs₂ : List (Rewrite α)}
    (heq : FoliationEquiv rs₁ rs₂) :
    PairwiseOrthogonal rs₁ → PairwiseOrthogonal rs₂ := by
  intro hp
  induction heq with
  | refl _ => exact hp
  | swap r₁ r₂ rs =>
    cases hp with
    | cons h₁ hp' =>
      cases hp' with
      | cons h₂ hrest =>
        refine PairwiseOrthogonal.cons ?_ (PairwiseOrthogonal.cons ?_ hrest)
        · intro r' hr'
          cases hr' with
          | head => exact orthogonal_symm (h₁ r₂ (List.Mem.head _))
          | tail _ hmem => exact h₂ r' hmem
        · intro r' hr'
          exact h₁ r' (List.Mem.tail _ hr')
  | cons r hsub ih =>
    cases hp with
    | cons hr hrest =>
      refine PairwiseOrthogonal.cons ?_ (ih hrest)
      intro r' hr'
      exact hr r' ((foliationEquiv_mem hsub r').mpr hr')
  | trans _ _ ih₁ ih₂ =>
    exact ih₂ (ih₁ hp)

/-- Causal invariance across foliations: permuting orthogonal rewrites never changes final state. -/
theorem foliation_invariance {α : Type u} {rs₁ rs₂ : List (Rewrite α)}
    (heq : FoliationEquiv rs₁ rs₂) :
    PairwiseOrthogonal rs₁ → ∀ (s : Nat → α), applyAll rs₁ s = applyAll rs₂ s := by
  induction heq with
  | refl _ => intro _ _; rfl
  | swap r₁ r₂ rs =>
    intro hp s
    cases hp with
    | cons h₁ _ =>
      have horth : Orthogonal r₁ r₂ := h₁ r₂ (List.Mem.head _)
      simp only [applyAll, apply_comm horth s]
  | cons r _ ih =>
    intro hp s
    cases hp with
    | cons _ hrest => exact ih hrest (r.step s)
  | trans h₁₂ _ ih₁ ih₂ =>
    intro hp s
    rw [ih₁ hp s, ih₂ (foliationEquiv_pairwise h₁₂ hp) s]

/-- Bounded-observer coarse-graining: an observer inspecting only `obsPorts` sees identical
summaries across any rewrite whose write footprint is disjoint from `obsPorts`. -/
theorem observer_invariant {α : Type u} {β : Type v}
    (obs : (Nat → α) → β) (obsPorts : List Nat)
    (hobs : ∀ s₁ s₂ : Nat → α, (∀ p, p ∈ obsPorts → s₁ p = s₂ p) → obs s₁ = obs s₂)
    (r : Rewrite α) (hdisj : DisjointPorts r.writes obsPorts) (s : Nat → α) :
    obs (r.step s) = obs s := by
  apply hobs
  intro p hp
  exact r.frame s p (fun hw => hdisj p hw hp)

end Playbox
