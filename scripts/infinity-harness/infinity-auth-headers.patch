diff --git a/crates/rap-client/tests/scoped_headers.rs b/crates/rap-client/tests/scoped_headers.rs
new file mode 100644
index 0000000..e644b1f
--- /dev/null
+++ b/crates/rap-client/tests/scoped_headers.rs
@@ -0,0 +1,34 @@
+use rap_client::http::{HttpClient, SimpleHttpClient};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpListener;
+
+/// Serve one request and return the raw request head.
+async fn serve_once(listener: TcpListener) -> String {
+    let (mut sock, _) = listener.accept().await.unwrap();
+    let mut buf = vec![0u8; 4096];
+    let n = sock.read(&mut buf).await.unwrap();
+    sock.write_all(b"HTTP/1.1 200 OK\r\ncontent-length: 2\r\nconnection: close\r\n\r\nok")
+        .await
+        .unwrap();
+    String::from_utf8_lossy(&buf[..n]).to_ascii_lowercase()
+}
+
+#[tokio::test]
+async fn headers_go_only_to_the_server_they_are_scoped_to() {
+    let scoped = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let other = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let scoped_url = format!("http://{}", scoped.local_addr().unwrap());
+    let other_url = format!("http://{}", other.local_addr().unwrap());
+    let client = SimpleHttpClient::new().with_headers_for(
+        scoped_url.clone(),
+        [("Authorization".to_owned(), "Bearer secret-token".to_owned())],
+    );
+
+    let a = tokio::spawn(serve_once(scoped));
+    client.get(&format!("{scoped_url}/x")).await.unwrap();
+    assert!(a.await.unwrap().contains("authorization: bearer secret-token"));
+
+    let b = tokio::spawn(serve_once(other));
+    client.post(&format!("{other_url}/x"), "{}").await.unwrap();
+    assert!(!b.await.unwrap().contains("secret-token"));
+}
