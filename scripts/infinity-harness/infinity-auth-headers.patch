+    /// Send `headers` with every request to a URL starting with `url_prefix` (and to no other host).
+    pub fn with_headers_for(
+        mut self,
+        url_prefix: impl Into<String>,
+        headers: impl IntoIterator<Item = (String, String)>,
+    ) -> Self {
+        let headers: Vec<(String, String)> = headers.into_iter().collect();
+        if !headers.is_empty() {
+            Arc::make_mut(&mut self.scoped_headers).push((url_prefix.into(), headers));
+        }
+        self
+    }
+
+    fn scoped(&self, url: &str, mut req: reqwest::RequestBuilder) -> reqwest::RequestBuilder {
+        for (prefix, headers) in self.scoped_headers.iter() {
+            if url.starts_with(prefix.as_str()) {
+                for (name, value) in headers {
+                    req = req.header(name.as_str(), value.as_str());
+                }
+            }
+        }
+        req
+    }
 }
 
